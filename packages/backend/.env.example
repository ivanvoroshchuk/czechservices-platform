# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/czechservices"

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET="your-super-secret-key-change-in-production-min-32-chars-long"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"
JWT_EXPIRATION="900" # 15 minutes in seconds
JWT_REFRESH_EXPIRATION="604800" # 7 days in seconds

# ============================================
# VERIFF (18+ AGE VERIFICATION)
# ============================================
VERIFF_API_KEY="test_key_from_veriff_dashboard"
VERIFF_API_URL="https://api.veriff.me"

# ============================================
# STRIPE (PAYMENTS)
# ============================================
STRIPE_SECRET_KEY="sk_test_your_stripe_test_key"
STRIPE_PUBLIC_KEY="pk_test_your_stripe_test_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# ============================================
# AWS S3 (MEDIA STORAGE)
# ============================================
AWS_S3_BUCKET="czechservices-media"
AWS_S3_REGION="eu-central-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"

# ============================================
# REDIS (CACHE & SESSIONS)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# APPLICATION
# ============================================
NODE_ENV="development"
API_PORT=3000
API_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

# ============================================
# LOGGING
# ============================================
LOG_LEVEL="debug"

# ============================================
# EMAIL (OPTIONAL - SendGrid)
# ============================================
# SENDGRID_API_KEY="your_sendgrid_api_key"
# SENDER_EMAIL="noreply@czechservices.cz"

# ============================================
# SMS (OPTIONAL - Twilio)
# ============================================
# TWILIO_ACCOUNT_SID="your_twilio_account_sid"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
